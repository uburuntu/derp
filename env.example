# Copy to .env (gitignored). Only the first block is required; uncomment optional
# settings only when they have a value (an empty typed value fails to parse).
ENVIRONMENT=dev
TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://derp:derp@localhost:5434/derp
OPENROUTER_API_KEY=

# Operators: Telegram user IDs allowed to run owner commands (JSON list), and the
# chat that receives error digests (other owner pings go to owners' DMs)
OWNER_IDS=[]
# OPS_CHAT_ID=

# Optional — telemetry fails soft without it; the URL (project link) is added to error digests
# LOGFIRE_TOKEN=
# LOGFIRE_URL=

# Optional third-party tools; tools hide themselves when unset
# WOLFRAM_APP_ID=
# JDOODLE_CLIENT_ID=
# JDOODLE_CLIENT_SECRET=
# ACRCLOUD_HOST=
# ACRCLOUD_ACCESS_KEY=
# ACRCLOUD_ACCESS_SECRET=

# Any Settings field can be overridden, nested ones with "__", e.g.
# RUN_CAPS__TOOL_CALLS=8
# MODEL_PINS='{"chat": {"model": "openai/gpt-6-luna"}}'
