# Environment configuration for Derp Telegram Bot
# Copy this file to .env and fill in your actual values

# Required: Environment type (dev or prod)
ENVIRONMENT=dev

# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Public bot username used in Telegram links
BOT_USERNAME=DerpRobot

# Required: PostgreSQL database connection (asyncpg format)
DATABASE_URL=postgresql+asyncpg://derp:derp@localhost:5432/derp
# Optional override used only by Docker Compose
# DOCKER_DATABASE_URL=postgresql+asyncpg://derp:derp@db:5432/derp

# Optional: Maximum updates processed concurrently
POLLING_CONCURRENCY=10
# Keep false through deployment and the real 1-Star purchase/refund smoke test.
PUBLIC_PURCHASES_ENABLED=false
# Short-lived generated media. Production overrides this with the private mount
# at /var/lib/derp/artifacts.
ARTIFACT_STORE_PATH=/tmp/derp-artifacts
# Optional dedicated callback key; bot-token derivation is the safe default.
# CALLBACK_SIGNING_SECRET=replace_with_at_least_32_random_bytes
# Local file used by the Docker event-loop health check.
RUNTIME_HEALTH_PATH=/tmp/derp-runtime-ready

# Required: Google TTS and explicit inference-rollback key
GOOGLE_API_PAID_KEY=your_paid_google_api_key_here

# Required for enabled OpenRouter inference features. Set [] for supported Google
# rollback paths; zero-cost OpenRouter and free inline inference then fail closed.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_APP_TITLE=Derp
# Defaults to https://t.me/<BOT_USERNAME> when omitted.
# OPENROUTER_APP_URL=https://t.me/DerpRobot
# Only exposed OpenRouter-backed surfaces belong here. TTS stays on Google;
# thinking, video generation, and standalone transcription remain fail closed.
OPENROUTER_ENABLED_FEATURES=["chat","inline_chat","image_generate","image_edit"]
# Zero-cost models are unlimited after versioned consent. They are non-ZDR,
# private/inline only, and never trigger an unexpected paid fallback. Paid and
# group inference uses the reviewed private ZDR routes.

# Required: Logfire token for logging
LOGFIRE_TOKEN=your_logfire_token_here
# Opt in only for local debugging; production always keeps AI content disabled.
LOGFIRE_CAPTURE_AI_CONTENT=false

# Required in production. Operators are deployment owners, not chat admins.
# JSON is recommended; comma-separated IDs are also accepted.
OPERATOR_IDS=[]
# Deprecated migration alias: ADMIN_IDS=[]
