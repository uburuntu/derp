# Copy to .env (gitignored). Only the first block is required.
ENVIRONMENT=dev
TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://derp:derp@localhost:5434/derp
OPENROUTER_API_KEY=

# Operators (D74, D88)
OWNER_IDS=[28006241]
OPS_CHAT_ID=-1001292994444

# Optional — telemetry fails soft without it (D113)
LOGFIRE_TOKEN=

# Optional third-party tools (D101); tools hide themselves when unset
WOLFRAM_APP_ID=
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# Any Settings field can be overridden, nested ones with "__", e.g.
# RUN_CAPS__TOOL_CALLS=8
# MODEL_PINS='{"chat": {"model": "openai/gpt-6-luna"}}'
