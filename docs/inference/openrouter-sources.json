{
  "schema_version": 1,
  "provider": "openrouter",
  "reviewed_snapshot": "docs/inference/openrouter-reviewed.json",
  "references_root": "references/openrouter",
  "default_policy_profile": "private_zdr",
  "policy_profiles": {
    "private_zdr": {
      "allow_fallbacks": true,
      "allowed_contexts": [
        "group",
        "inline",
        "private"
      ],
      "data_collection": "deny",
      "require_parameters": true,
      "requires_versioned_consent": false,
      "zero_data_retention": true
    },
    "consented_non_zdr_free": {
      "allow_fallbacks": true,
      "allowed_contexts": [
        "inline",
        "private"
      ],
      "data_collection": "allow",
      "require_parameters": true,
      "requires_versioned_consent": true,
      "zero_data_retention": false
    }
  },
  "openapi_paths": [
    "/audio/speech",
    "/audio/transcriptions",
    "/chat/completions",
    "/endpoints/zdr",
    "/images",
    "/images/models",
    "/images/models/{author}/{slug}/endpoints",
    "/models",
    "/models/{author}/{slug}/endpoints",
    "/videos",
    "/videos/models"
  ],
  "sources": [
    {
      "id": "docs-index",
      "url": "https://openrouter.ai/docs/llms.txt",
      "format": "text",
      "destination": "docs/llms.txt",
      "projection": "docs_index"
    },
    {
      "id": "openapi",
      "url": "https://openrouter.ai/openapi.json",
      "format": "json",
      "destination": "api/openapi.json",
      "projection": "openapi_contract"
    },
    {
      "id": "models",
      "url": "https://openrouter.ai/api/v1/models",
      "format": "json",
      "destination": "api/models.json",
      "projection": "primary_models"
    },
    {
      "id": "image-models",
      "url": "https://openrouter.ai/api/v1/images/models",
      "format": "json",
      "destination": "api/image-models.json",
      "projection": "image_models"
    },
    {
      "id": "video-models",
      "url": "https://openrouter.ai/api/v1/videos/models",
      "format": "json",
      "destination": "api/video-models.json",
      "projection": "video_models"
    },
    {
      "id": "zdr-endpoints",
      "url": "https://openrouter.ai/api/v1/endpoints/zdr",
      "format": "json",
      "destination": "api/zdr-endpoints.json",
      "projection": "zdr_endpoints"
    },
    {
      "id": "models-guide",
      "url": "https://openrouter.ai/docs/guides/overview/models.md",
      "format": "text",
      "destination": "docs/models.md",
      "projection": "full"
    },
    {
      "id": "image-guide",
      "url": "https://openrouter.ai/docs/guides/overview/multimodal/image-generation.md",
      "format": "text",
      "destination": "docs/image-generation.md",
      "projection": "full"
    },
    {
      "id": "video-guide",
