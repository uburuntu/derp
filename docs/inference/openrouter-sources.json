      "format": "text",
      "destination": "docs/provider-selection.md",
      "projection": "full"
    },
    {
      "id": "model-fallbacks",
      "url": "https://openrouter.ai/docs/guides/routing/model-fallbacks.md",
      "format": "text",
      "destination": "docs/model-fallbacks.md",
      "projection": "full"
    },
    {
      "id": "free-variant",
      "url": "https://openrouter.ai/docs/guides/routing/model-variants/free.md",
      "format": "text",
      "destination": "docs/free-variant.md",
      "projection": "full"
    },
    {
      "id": "zero-data-retention",
      "url": "https://openrouter.ai/docs/guides/features/zdr.md",
      "format": "text",
      "destination": "docs/zero-data-retention.md",
      "projection": "full"
    },
    {
      "id": "data-collection",
      "url": "https://openrouter.ai/docs/guides/privacy/data-collection.md",
      "format": "text",
      "destination": "docs/data-collection.md",
      "projection": "full"
    },
    {
      "id": "provider-logging",
      "url": "https://openrouter.ai/docs/guides/privacy/provider-logging.md",
      "format": "text",
      "destination": "docs/provider-logging.md",
      "projection": "full"
    }
  ],
  "endpoint_sources": [
    {
      "id": "model-endpoints",
      "catalog": "primary",
      "url_template": "https://openrouter.ai/api/v1/models/{slug}/endpoints",
      "destination": "api/model-endpoints/{slug_file}.json",
      "projection": "model_endpoints"
    },
    {
      "id": "image-endpoints",
      "catalog": "images",
      "url_template": "https://openrouter.ai/api/v1/images/models/{slug}/endpoints",
      "destination": "api/image-endpoints/{slug_file}.json",
      "projection": "image_endpoints"
    }
  ],
