      "format": "text",
      "destination": "docs/video-generation.md",
      "projection": "full"
    },
    {
      "id": "stt-guide",
      "url": "https://openrouter.ai/docs/guides/overview/multimodal/stt.md",
      "format": "text",
      "destination": "docs/stt.md",
      "projection": "full"
    },
    {
      "id": "tts-guide",
      "url": "https://openrouter.ai/docs/guides/overview/multimodal/tts.md",
      "format": "text",
      "destination": "docs/tts.md",
      "projection": "full"
    },
    {
      "id": "provider-selection",
